#include "led_matrix.h"
#define MAX_LED_MATRIX 8

// Each element = pattern for one column (8 rows -> 8 bits)
uint8_t matrix_buffer[8] = {
    0x3C, // 00111100  -> part of 'A'
    0x42, // 01000010
    0x42, // 01000010
    0x7E, // 01111110
    0x42, // 01000010
    0x42, // 01000010
    0x42, // 01000010
    0x00  // blank column
};
int row_pin[8] = {
	GPIO_PIN_8,
	GPIO_PIN_9,
	GPIO_PIN_10,
	GPIO_PIN_11,
	GPIO_PIN_12,
	GPIO_PIN_13,
	GPIO_PIN_14,
	GPIO_PIN_15
};

void updateLEDMatrix(int index) {
    // 1. Tắt tất cả các cột (ENM)
    HAL_GPIO_WritePin(GPIOA,
        GPIO_PIN_2|GPIO_PIN_3|GPIO_PIN_10|GPIO_PIN_11|
        GPIO_PIN_12|GPIO_PIN_13|GPIO_PIN_14|GPIO_PIN_15,
        GPIO_PIN_SET);

    // 2. Ghi dữ liệu hàng (ROW0–ROW7) từ matrix_buffer[index]
    uint8_t pattern = matrix_buffer[index];

    for (int row = 0; row < 8; row++) {
        if ((pattern >> row) & 1) {
            // LED sáng tại hàng row (bit = 1)
            HAL_GPIO_WritePin(GPIOB, row_pin[row], GPIO_PIN_RESET);
        } else {
            // LED tắt tại hàng row (bit = 0)
            HAL_GPIO_WritePin(GPIOB, row_pin[row], GPIO_PIN_SET);
        }
    }

    // 3. Bật đúng cột tương ứng (ENM)
    switch(index) {
        case 0: HAL_GPIO_WritePin(GPIOA, GPIO_PIN_2, GPIO_PIN_RESET); break;
        case 1: HAL_GPIO_WritePin(GPIOA, GPIO_PIN_3, GPIO_PIN_RESET); break;
        case 2: HAL_GPIO_WritePin(GPIOA, GPIO_PIN_10, GPIO_PIN_RESET); break;
        case 3: HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, GPIO_PIN_RESET); break;
        case 4: HAL_GPIO_WritePin(GPIOA, GPIO_PIN_12, GPIO_PIN_RESET); break;
        case 5: HAL_GPIO_WritePin(GPIOA, GPIO_PIN_13, GPIO_PIN_RESET); break;
        case 6: HAL_GPIO_WritePin(GPIOA, GPIO_PIN_14, GPIO_PIN_RESET); break;
        case 7: HAL_GPIO_WritePin(GPIOA, GPIO_PIN_15, GPIO_PIN_RESET); break;
        default: break;
    }
}
