#include "led_matrix.h"
#define MAX_LED_MATRIX 8

// Each element = pattern for one column (8 rows -> 8 bits)
uint8_t matrix_buffer[8] = {
    0x3C, // 00111100  -> part of 'A'
    0x42, // 01000010
    0x42, // 01000010
    0x7E, // 01111110
    0x42, // 01000010
    0x42, // 01000010
    0x42, // 01000010
    0x00  // blank column
};

void updateLEDMatrix(int index) {
    // 1. Disable all ENM (columns off)
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_2|GPIO_PIN_3|GPIO_PIN_10|GPIO_PIN_11|
    		GPIO_PIN_12|GPIO_PIN_13|GPIO_PIN_14|GPIO_PIN_15, GPIO_PIN_SET);

    // 2. Write row data (PB8–PB15)

    // 3. Enable the selected column
    switch(index) {
		case 0:
			HAL_GPIO_WritePin(GPIOA, GPIO_PIN_2, RESET);
			HAL_GPIO_WritePin(GPIOB, GPIO_PIN_8, SET);
			break;
		case 1:
			HAL_GPIO_WritePin(GPIOA, GPIO_PIN_3, RESET);
			HAL_GPIO_WritePin(GPIOB, GPIO_PIN_9, SET);
			break;
		case 2:
			HAL_GPIO_WritePin(GPIOA, GPIO_PIN_10, RESET);
			HAL_GPIO_WritePin(GPIOB, GPIO_PIN_10, SET);
			break;
		case 3:
			HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, RESET);
			HAL_GPIO_WritePin(GPIOB, GPIO_PIN_11, SET);
			break;
		case 4:
			HAL_GPIO_WritePin(GPIOA, GPIO_PIN_12, RESET);
			HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12, SET);
			break;
		case 5:
			HAL_GPIO_WritePin(GPIOA, GPIO_PIN_13, RESET);
			HAL_GPIO_WritePin(GPIOB, GPIO_PIN_13, SET);
			break;
		case 6:
			HAL_GPIO_WritePin(GPIOA, GPIO_PIN_14, RESET);
			HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12, RESET);
			HAL_GPIO_WritePin(GPIOB, GPIO_PIN_14, SET);
			break;
		case 7:
			HAL_GPIO_WritePin(GPIOA, GPIO_PIN_15, RESET);
			HAL_GPIO_WritePin(GPIOB, GPIO_PIN_15, SET);
			break;
        default: break;
    }
}
